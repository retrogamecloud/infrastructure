{
  "name": "Nomenclatura ramas - Estándar",
  "description": "Obliga a usar prefijos estándar para ramas: feature/, bugfix/, hotfix/, release/, chore/, docs/, refactor/, test/, ci/",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/**"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/master",
        "refs/heads/develop",
        "refs/heads/staging",
        "refs/heads/production"
      ]
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "operator": "regex",
        "pattern": "^(feature|bugfix|hotfix|release|chore|docs|refactor|test|ci)/[a-z0-9-]+$",
        "negate": false
      }
    },
    {
      "type": "deletion"
    }
  ],
  "bypass_actors": [
    {
      "actor_type": "RepositoryRole",
      "actor_id": 5,
      "bypass_mode": "always"
    }
  ]
}
