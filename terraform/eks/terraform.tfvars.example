# Ejemplo de archivo terraform.tfvars
# Copiar este archivo a terraform.tfvars y ajustar valores

# AWS Configuration
aws_region  = "eu-west-1"
aws_profile = "retrogamecloud"
environment = "dev"
cluster_name = "retrogame-eks"
cluster_version = "1.32"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"
azs = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]
private_subnets = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnets = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# EKS Node Group Configuration
node_instance_types = ["t3.small"]
node_desired_size = 3
node_min_size = 1
node_max_size = 4

# Feature Flags
enable_cluster_autoscaler = true
enable_metrics_server = true
enable_aws_load_balancer_controller = true

# RDS Configuration
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "retrogc"
db_username          = "retrogc"
db_password          = "CAMBIAME-en-produccion123"

# Application Secrets
jwt_secret = "CAMBIAME-en-produccion321"

# Additional Tags
tags = {
  Project = "RetroGameCloud"
  Owner   = "XII DevOps and Cloud Computing Team"
}